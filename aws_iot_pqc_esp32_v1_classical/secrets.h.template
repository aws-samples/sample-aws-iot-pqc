/*
 * secrets.h - Configuration for v1.0 Classical TLS firmware
 *
 * This file is identical to the v2.0 PQC firmware's secrets.h.
 * Both versions use the same WiFi, endpoint, and certificates.
 * The only difference is the TLS library used (mbedTLS vs wolfSSL).
 */

#ifndef SECRETS_H
#define SECRETS_H

// ─── WiFi Configuration ─────────────────────────────────────────────────────
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ─── Logging Configuration ──────────────────────────────────────────────────
//   0 = NONE, 1 = ERROR, 2 = WARN, 3 = INFO, 4 = DEBUG, 5 = VERBOSE
#define LOG_LEVEL  3

// ─── AWS IoT Core Configuration ─────────────────────────────────────────────
// For the workshop, the ESP32 connects to the local Mosquitto broker
// on the Raspberry Pi. The classical firmware uses standard TLS 1.2.
#define MQTT_BROKER_ENDPOINT "RASPBERRY_PI_IP_ADDRESS"
#define MQTT_BROKER_PORT     8883

// Device identity is derived at runtime from the ESP32's MAC address.
// Format: "esp32-XXYYZZ" (last 3 bytes of MAC). No static THINGNAME needed.

// AWS IoT Core endpoint (used by the Mosquitto bridge, not by this device)
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"
#define AWS_IOT_PORT     8883

// ─── Broker CA Certificate ───────────────────────────────────────────────────
// Workshop CA certificate (signs the Mosquitto broker server cert).
// For direct IoT Core connections, replace with AmazonRootCA1.pem.
// Paste the full PEM here, including the BEGIN/END CERTIFICATE lines.
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
REPLACE_WITH_WORKSHOP_CA_CERTIFICATE_PEM
)EOF";

// ─── Fleet Device Certificate (shared by all workshop devices) ──────────────
// All devices share this cert. Identity comes from MAC-derived client ID.
// Paste the full PEM here, including the BEGIN/END CERTIFICATE lines.
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
REPLACE_WITH_YOUR_DEVICE_CERTIFICATE_PEM
)KEY";

// ─── Device Private Key ─────────────────────────────────────────────────────
// Paste the full private-key PEM here, including its BEGIN/END lines.
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
REPLACE_WITH_YOUR_DEVICE_PRIVATE_KEY_PEM
)KEY";

// ─── OTA Firmware Signer CA Root(s) ─────────────────────────────────────────
// Trust anchor for the on-device OTA signature verifier (Workstream 3). The
// real CodeBuild artifact injects the account's signer CA root(s) here (both
// the classical and ML-DSA-44 roots, concatenated) and defines
// OTA_SIGNER_CA_ROOT_DEFINED. For a local/desktop build, paste the signer CA
// root PEM(s) below; leaving the placeholder makes the chain check fail closed.
#define OTA_SIGNER_CA_ROOT_DEFINED 1
static const char OTA_SIGNER_CA_ROOT[] = R"EOF(
REPLACE_WITH_SIGNER_CA_ROOT_PEM
)EOF";

#endif // SECRETS_H
