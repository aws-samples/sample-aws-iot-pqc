{
  "Comment": "PQC migration workflow: resolve the variant to its shared, prebuilt signed image (built once per deployment), push it OTA, and report live migrationStatus to the device record. No per-device build.",
  "StartAt": "SetStatusBuilding",
  "States": {
    "SetStatusBuilding": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DeviceTableName}",
        "Key": { "thingName": { "S.$": "$.thingName" } },
        "UpdateExpression": "SET migrationStatus = :s REMOVE migrationError",
        "ExpressionAttributeValues": { ":s": { "S": "building" } }
      },
      "ResultPath": null,
      "Next": "PrepareBuild",
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "SetStatusFailed" } ]
    },

    "PrepareBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Pass the requested firmware variant through. prepare-build defaults it to 'pqc' when absent (backward compatible), checks the shared image exists, and echoes the resolved variant, version and shared s3Key back.",
      "Parameters": {
        "FunctionName": "${PrepareBuildFunctionArn}",
        "Payload": {
          "thingName.$": "$.thingName",
          "variant.$": "$.variant"
        }
      },
      "ResultSelector": {
        "thingName.$": "$.Payload.thingName",
        "serialNumber.$": "$.Payload.serialNumber",
        "variant.$": "$.Payload.variant",
        "buildVariant.$": "$.Payload.buildVariant",
        "version.$": "$.Payload.version",
        "signerEra.$": "$.Payload.signerEra",
        "sigAlg.$": "$.Payload.sigAlg",
        "s3Key.$": "$.Payload.s3Key"
      },
      "ResultPath": "$.prepare",
      "Next": "SetStatusPushing",
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "SetStatusFailed" } ]
    },

    "SetStatusPushing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DeviceTableName}",
        "Key": { "thingName": { "S.$": "$.thingName" } },
        "UpdateExpression": "SET migrationStatus = :s",
        "ExpressionAttributeValues": { ":s": { "S": "pushing-ota" } }
      },
      "ResultPath": null,
      "Next": "PublishOta",
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "SetStatusFailed" } ]
    },

    "PublishOta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PublishOtaFunctionArn}",
        "Payload": {
          "thingName.$": "$.thingName",
          "serialNumber.$": "$.prepare.serialNumber",
          "s3Key.$": "$.prepare.s3Key",
          "version.$": "$.prepare.version",
          "variant.$": "$.prepare.variant",
          "sigAlg.$": "$.prepare.sigAlg"
        }
      },
      "ResultPath": "$.publish",
      "Next": "SetStatusRebooting",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "SetStatusFailed" } ]
    },

    "SetStatusRebooting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DeviceTableName}",
        "Key": { "thingName": { "S.$": "$.thingName" } },
        "UpdateExpression": "SET migrationStatus = :s",
        "ExpressionAttributeValues": { ":s": { "S": "rebooting" } }
      },
      "ResultPath": null,
      "Next": "Succeed"
    },

    "Succeed": { "Type": "Succeed" },

    "SetStatusFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DeviceTableName}",
        "Key": { "thingName": { "S.$": "$.thingName" } },
        "UpdateExpression": "SET migrationStatus = :s, migrationError = :e",
        "ExpressionAttributeValues": {
          ":s": { "S": "failed" },
          ":e": { "S.$": "States.Format('{}', $.error.Cause)" }
        }
      },
      "ResultPath": null,
      "Next": "Fail"
    },

    "Fail": { "Type": "Fail", "Error": "PqcMigrationFailed", "Cause": "See migrationError on the device record." }
  }
}
