          <mxGeometry x="420" y="125" width="62" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p2-prepare" value="Lambda&#10;prepare-build&#10;(reads SSM wifi+broker)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="p2-cloud" vertex="1">
          <mxGeometry x="560" y="45" width="62" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p2-ssm" value="SSM Parameter Store&#10;wifi + broker&#10;(single source of truth)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager_parameter_store;" parent="p2-cloud" vertex="1">
          <mxGeometry x="900" y="45" width="62" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p2-codebuild" value="CodeBuild&#10;firmware-build (PQC)&#10;startBuild.sync" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4AB29A;gradientDirection=north;fillColor=#3B8272;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" parent="p2-cloud" vertex="1">
