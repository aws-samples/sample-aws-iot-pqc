        <mxCell id="p2e8" value="migrationStatus" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666;" parent="p2-cloud" source="p2-sfn" target="p2-ddb" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2e9" value="8. OTA download &#8594; reboot into PQC &#8594; rejoin WiFi &#8594; reconnect (ML-KEM)" style="endArrow=classic;html=1;strokeColor=#00CC00;strokeWidth=2;" parent="1" source="p2-iot" target="p2-device" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
