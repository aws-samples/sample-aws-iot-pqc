        <mxCell id="p2-device" value="ESP32-S3&#10;OTA_1 PQC&#10;(rejoins WiFi, ML-KEM)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.iot_thing_freertos_device;" parent="1" vertex="1">
          <mxGeometry x="1120" y="830" width="70" height="70" as="geometry" />
