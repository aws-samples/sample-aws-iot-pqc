/*
 * secrets.h - Configuration and credentials for AWS IoT Core PQC connection
 *
 * INSTRUCTIONS:
 * 1. Replace the WiFi credentials with your network details.
 * 2. Replace the AWS IoT endpoint with your account's endpoint.
 *    Find it in the AWS IoT Console under Settings, or run:
 *      aws iot describe-endpoint --endpoint-type iot:Data-ATS
 * 3. Paste your device certificate and private key from the AWS IoT
 *    Console (when you create a Thing and download the certificates).
 * 4. The Amazon Root CA 1 is provided below. If you need a different
 *    root CA, download it from:
 *      https://www.amazontrust.com/repository/
 *
 * SECURITY NOTE:
 *   Never commit this file with real credentials to version control.
 *   The certificates below are placeholders only.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ─── WiFi Configuration ─────────────────────────────────────────────────────
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ─── Logging Configuration ──────────────────────────────────────────────────
// Controls the verbosity of serial output via the Espressif logging framework.
// Set to one of:
//   0 = ESP_LOG_NONE    - No log output
//   1 = ESP_LOG_ERROR   - Errors only (critical failures)
//   2 = ESP_LOG_WARN    - Errors + warnings (connection retries, fallbacks)
//   3 = ESP_LOG_INFO    - Normal operation (connections, publishes) [DEFAULT]
//   4 = ESP_LOG_DEBUG   - Detailed diagnostics (heap, cert sizes, task info)
//   5 = ESP_LOG_VERBOSE - Everything (I/O byte counts, handshake polling)
#define LOG_LEVEL  3

// ─── AWS IoT Core Configuration ─────────────────────────────────────────────
// For the workshop, the ESP32 connects to the local Mosquitto PQC broker
// on the Raspberry Pi, NOT directly to AWS IoT Core. Mosquitto bridges
// messages to IoT Core on behalf of the device.
//
// Set MQTT_BROKER_ENDPOINT to the Raspberry Pi's IP address on the local
// network (e.g., "192.168.1.100"). The port remains 8883 (TLS).
#define MQTT_BROKER_ENDPOINT "RASPBERRY_PI_IP_ADDRESS"
#define MQTT_BROKER_PORT     8883

// Device identity is derived at runtime from the ESP32's MAC address.
// Format: "esp32-XXYYZZ" (last 3 bytes of MAC). No static THINGNAME needed.
// This allows a single firmware binary to work on any device.

// AWS IoT Core endpoint (used by the Mosquitto bridge, not by this device directly)
// Keep this for reference / fallback direct-connect mode.
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"
#define AWS_IOT_PORT     8883

// MQTT topics
// Topics are auto-generated from THINGNAME using AWS IoT best practices:
//   Telemetry (device → cloud):  dt/<THINGNAME>/telemetry
//   Lifecycle (online/offline):  dt/<THINGNAME>/lifecycle
//   Commands (cloud → device):   cmd/<THINGNAME>/+
//
// The old flat topics below are kept for backward compatibility with
// existing IoT Rules. Remove them if you only use the structured topics.
#define AWS_IOT_PUBLISH_TOPIC   "esp32/pqc/pub"
#define AWS_IOT_SUBSCRIBE_TOPIC "esp32/pqc/sub"

// ─── Broker CA Certificate ───────────────────────────────────────────────────
// This is the workshop CA certificate that signed the Mosquitto broker's
// server certificate. Generated by greengrass/certs/generate-broker-certs.sh.
// For direct AWS IoT Core connections (at home), replace with AmazonRootCA1.pem.
// Download from: https://www.amazontrust.com/repository/AmazonRootCA1.pem
// Paste the full PEM here, including the BEGIN/END CERTIFICATE lines.
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
REPLACE_WITH_WORKSHOP_CA_CERTIFICATE_PEM
)EOF";

// ─── Fleet Device Certificate (shared by all workshop devices) ──────────────
// All devices share this certificate. Identity comes from MAC-derived client ID.
// Paste the full PEM here, including the BEGIN/END CERTIFICATE lines.
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
REPLACE_WITH_YOUR_DEVICE_CERTIFICATE_PEM
)KEY";

// ─── Device Private Key ─────────────────────────────────────────────────────
// Per-device private key paired with the certificate above.
// Paste the full private-key PEM here, including its BEGIN/END lines.
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
REPLACE_WITH_YOUR_DEVICE_PRIVATE_KEY_PEM
)KEY";

// ─── OTA Firmware Signer CA Root(s) ─────────────────────────────────────────
// Trust anchor for the on-device OTA signature verifier (Workstream 3). The
// real CodeBuild artifact injects the account's signer CA root(s) here (both
// the classical and ML-DSA-44 roots, concatenated) and defines
// OTA_SIGNER_CA_ROOT_DEFINED. For a local/desktop build, paste the signer CA
// root PEM(s) below; leaving the placeholder makes the chain check fail closed.
#define OTA_SIGNER_CA_ROOT_DEFINED 1
static const char OTA_SIGNER_CA_ROOT[] = R"EOF(
REPLACE_WITH_SIGNER_CA_ROOT_PEM
)EOF";

#endif // SECRETS_H
