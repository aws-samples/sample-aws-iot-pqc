/*
 * secrets.h - build settings for a local/desktop build of this sketch.
 *
 * In the workshop, CodeBuild generates secrets.h (buildspec.yml), so you only
 * need this for a local build: copy it to secrets.h, pick the variant and set
 * the broker.
 *
 * This file holds NO secrets any more. The device keys, certificates, CA
 * roots and WiFi credentials are read at runtime from the "certs" NVS
 * partition (0x721000), which the Builder-Pi writes at registration. A device
 * flashed without that partition logs "[Setup] FATAL: no valid device
 * identity" and does not connect. To build one for a local test, run
 * shared/cert-issuer/issue_device_identity.py and flash its certs.bin at
 * 0x721000 alongside the app.
 */
#ifndef SECRETS_H
#define SECRETS_H

// ─── Firmware variant (required) ────────────────────────────────────────────
// FW_VARIANT_CLASSICAL, FW_VARIANT_PQC or FW_VARIANT_PQC_MLDSA. See
// variant_config.h for what each one changes.
#define FIRMWARE_VARIANT FW_VARIANT_PQC

// ─── Logging ────────────────────────────────────────────────────────────────
// 0 none, 1 error, 2 warn, 3 info (default), 4 debug, 5 verbose.
#define LOG_LEVEL  3

// ─── Broker ─────────────────────────────────────────────────────────────────
// The device connects to the workshop Mosquitto broker through its Network
// Load Balancer (BrokerEndpoint stack output), not directly to AWS IoT Core.
// Bare host name only; the port is separate. Use the listener that matches the
// variant: 8883 for classical and pqc, 8884 for pqc-mldsa.
#define MQTT_BROKER_ENDPOINT "REPLACE_WITH_BROKER_NLB_ENDPOINT"
#define MQTT_BROKER_PORT     8883

// Optional: FIRMWARE_VERSION and FIRMWARE_OTA_SIG_ALG default per variant.

#endif // SECRETS_H
