{
  "mcpServers": {
    "builder-mcp": {
      "autoApprove": [
        "ReadInternalWebsites",
        "InternalSearch",
        "BrazilBuildAnalyzerTool"
      ],
      "disabled": false,
      "timeout": 60,
      "type": "stdio",
      "command": "builder-mcp",
      "args": [],
      "env": {
        "PATH": "/Users/swaym/.toolbox/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "https://github.com/aws-samples/sample-drawio-mcp/releases/latest/download/drawio-mcp-server-latest.tgz",
        "--no-cache"
      ],
      "disabled": false,
      "autoApprove": [
        "create_diagram",
        "get_layout_guidance",
        "search_shapes",
        "list_categories",
        "list_shapes",
        "insert_aws_group",
        "batch_insert_vertices",
        "insert_library_shape",
