# Build artifacts
.build/
*.zip

# Secrets (never commit real credentials)
**/secrets.h
!**/secrets.h.template

# Generated bundles with credentials
esp32-arduino-bundle/
# Builder-Pi bundle is generated per-deployment by bundle-for-builder-pi.sh and
# contains a live SSM activation code + deployment-specific config — never commit it.
builder-pi-bundle/
builder-pi-bundle.zip

# Arduino CLI local data (toolchains, board packages — regenerable caches)
data/
staging/

# Node modules
node_modules/
dashboard/frontend/build/

# Dashboard-v2 generated artifacts (built per deploy; env-specific)
# - build/ is Vite output
# - src/config.js is the runtime config holder; the real endpoints are NOT
#   compiled in — they come from public/config.json at runtime. The deploy
#   writes public/config.json (env-specific); config.example.json is the
#   committed template.
raw_device_builder/dashboard-v2/frontend/build/
raw_device_builder/dashboard-v2/frontend/public/config.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
!.vscode/settings.json

# Python test harness (workshop-deployment-hardening)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/
